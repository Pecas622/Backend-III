    "mongoose": "^8.16.0",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "mocha": "^11.6.0",
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.1.1"
  }
