{
  "name": "back-iii-final",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "description": "API REST Backend III: e-commerce + adopción de mascotas, documentada con Swagger, testeada con Mocha/Chai/Supertest y dockerizada.",
  "author": "Santiago Zorrilla",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "mocha",
    "docker:build": "docker build -t pecas622/backend-iii:1.0.0 -t pecas622/backend-iii:latest .",
    "docker:push": "docker push pecas622/backend-iii:1.0.0 && docker push pecas622/backend-iii:latest",
    "docker:run": "docker run --rm -p 8080:8080 --env-file .env pecas622/backend-iii:latest"
  },
  "dependencies": {
